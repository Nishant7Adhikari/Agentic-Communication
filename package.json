{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace=@workspace/api-server run dev",
    "dev:web": "npm --workspace=@workspace/agent-coordination-hub run dev",
    "build": "npm run typecheck && npm --workspaces --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm --workspace=@workspace/api-server run typecheck",
    "ip": "node ./scripts/get-ip.js",
    "tunnel": "npx localtunnel --port 5000"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
